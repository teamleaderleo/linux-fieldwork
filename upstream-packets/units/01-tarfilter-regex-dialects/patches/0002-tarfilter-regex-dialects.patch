+            result.append(quantifier)
+            repeated = True
+            previous_quantifier = quantifier
+            index = next_index
+            continue
+        if char == "{":
+            raise ValueError("invalid active regex interval")
+        result.append(char)
+        atom_start = len(result) - 1
+        repeated = False
+        previous_quantifier = None
+        index += 1
