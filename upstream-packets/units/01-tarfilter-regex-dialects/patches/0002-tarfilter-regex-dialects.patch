+def _quantifier_at(pattern, index):
+    char = pattern[index]
+    if char in "*+?":
+        return char, index + 1
+    if char != "{":
+        return None, index
+    match = re.match(
+        r"\{(?:[0-9]+(?:,[0-9]*)?|,[0-9]+)\}",
+        pattern[index:],
+    )
+    if match is None:
+        return None, index
+    token = match.group(0)
+    return token, index + len(token)
+
