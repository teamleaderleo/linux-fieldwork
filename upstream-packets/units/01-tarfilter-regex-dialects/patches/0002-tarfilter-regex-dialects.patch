+def _normalize_repeated_quantifiers(pattern, extended):
+    result = []
+    group_starts = []
+    atom_start = None
+    repeated = False
+    previous_quantifier = None
+    index = 0
+    while index < len(pattern):
+        char = pattern[index]
+        if char == "\\":
+            end = min(index + 2, len(pattern))
+            result.append(pattern[index:end])
+            atom_start = len(result) - 1
+            repeated = False
+            previous_quantifier = None
+            index = end
+            continue
+        if char == "[":
+            expression, index = _copy_bracket_expression(pattern, index)
+            result.append(expression)
+            atom_start = len(result) - 1
+            repeated = False
+            previous_quantifier = None
+            continue
+        if char == "(":
+            group_starts.append(len(result))
+            result.append(char)
+            atom_start = None
+            repeated = False
+            previous_quantifier = None
+            index += 1
+            continue
+        if char == ")":
+            if extended and not group_starts:
+                result.append(r"\)")
+                atom_start = len(result) - 1
+            else:
+                result.append(char)
+                atom_start = group_starts.pop() if group_starts else len(result) - 1
+            repeated = False
+            previous_quantifier = None
+            index += 1
+            continue
+        if char == "|":
+            result.append(char)
+            atom_start = None
+            repeated = False
+            previous_quantifier = None
+            index += 1
+            continue
