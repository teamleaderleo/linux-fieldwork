diff --git a/tests/tarfilter-parent-metadata b/tests/tarfilter-parent-metadata
new file mode 100755
index 0000000..9212cb8
--- /dev/null
+++ b/tests/tarfilter-parent-metadata
@@ -0,0 +1,122 @@
+#!/bin/sh
+set -eu
+export LC_ALL=C.UTF-8
+
+tmpdir=$(mktemp -d)
+trap 'rm -rf "$tmpdir"' EXIT INT TERM HUP
+
+MMTARFILTER=
+[ -x /usr/bin/mmtarfilter ] && MMTARFILTER=/usr/bin/mmtarfilter
+[ -x ./tarfilter ] && MMTARFILTER=./tarfilter
+[ -n "$MMTARFILTER" ]
+
+python3 - "$tmpdir/input.tar" <<'PY'
+import io
+import sys
+import tarfile
+
+out = sys.argv[1]
+with tarfile.open(out, "w", format=tarfile.PAX_FORMAT) as tf:
+    entries = [
+        (
+            "usr", tarfile.DIRTYPE, 0o700, 11, 21, 1700000001,
+            b"", "usr-parent",
+        ),
+        (
+            "usr/bin", tarfile.DIRTYPE, 0o711, 12, 22, 1700000002,
+            b"", "bin-parent",
+        ),
+        (
+            "usr/bin/tool", tarfile.REGTYPE, 0o755, 13, 23,
+            1700000003, b"tool\n", None,
+        ),
+        (
+            "usr2", tarfile.DIRTYPE, 0o750, 14, 24, 1700000004,
+            b"", "boundary-parent",
+        ),
+        (
+            "usr2/tool", tarfile.REGTYPE, 0o755, 15, 25,
+            1700000005, b"other\n", None,
+        ),
+        (
+            "opt", tarfile.DIRTYPE, 0o705, 16, 26, 1700000006,
+            b"", "unrelated-parent",
+        ),
+        (
+            "opt/tool", tarfile.REGTYPE, 0o755, 17, 27,
+            1700000007, b"opt\n", None,
+        ),
+        (
+            "linkroot", tarfile.SYMTYPE, 0o777, 18, 28,
+            1700000008, b"", "symlink-parent",
+        ),
+        (
+            "linkroot/tool", tarfile.REGTYPE, 0o744, 19, 29,
+            1700000009, b"linked\n", None,
+        ),
+    ]
+    for name, kind, mode, uid, gid, mtime, data, marker in entries:
+        member = tarfile.TarInfo(name)
+        member.type = kind
+        member.mode = mode
+        member.uid = uid
+        member.gid = gid
+        member.mtime = mtime
+        if kind == tarfile.SYMTYPE:
+            member.linkname = "usr/bin"
+        if marker:
+            member.pax_headers = {"SCHILY.xattr.user.unit21": marker}
+        if kind == tarfile.REGTYPE:
+            member.size = len(data)
+            tf.addfile(member, io.BytesIO(data))
+        else:
+            tf.addfile(member)
+PY
+
+check_case() {
+  label=$1
+  include=$2
+  expected=$3
+  output="$tmpdir/$label.tar"
+  "$MMTARFILTER" --path-exclude='/*' --path-include="$include" \
+    <"$tmpdir/input.tar" >"$output"
+  python3 - "$output" "$expected" <<'PY'
+import json
+import sys
+import tarfile
+
+archive, expected_json = sys.argv[1:]
+expected = json.loads(expected_json)
+with tarfile.open(archive, "r") as tf:
+    members = list(tf)
+actual = [m.name for m in members]
+assert actual == expected, (actual, expected)
+metadata = {m.name: m for m in members}
+if "usr" in metadata:
+    assert metadata["usr"].mode == 0o700
+    assert metadata["usr"].uid == 11
+    assert metadata["usr"].gid == 21
+    assert metadata["usr"].mtime == 1700000001
+    assert metadata["usr"].pax_headers["SCHILY.xattr.user.unit21"] == "usr-parent"
+if "usr/bin" in metadata:
+    assert metadata["usr/bin"].mode == 0o711
+    assert metadata["usr/bin"].uid == 12
+    assert metadata["usr/bin"].gid == 22
+    assert metadata["usr/bin"].mtime == 1700000002
+    assert metadata["usr/bin"].pax_headers["SCHILY.xattr.user.unit21"] == "bin-parent"
+if "linkroot" in metadata:
+    assert metadata["linkroot"].issym()
+    assert metadata["linkroot"].linkname == "usr/bin"
+    assert metadata["linkroot"].mode == 0o777
+    assert metadata["linkroot"].uid == 18
+    assert metadata["linkroot"].gid == 28
+    assert metadata["linkroot"].mtime == 1700000008
+    assert metadata["linkroot"].pax_headers["SCHILY.xattr.user.unit21"] == "symlink-parent"
+PY
+}
+
+check_case exact '/usr/bin/tool' '["usr", "usr/bin", "usr/bin/tool"]'
+check_case wildcard '/usr/*/tool' '["usr", "usr/bin", "usr/bin/tool"]'
+check_case character_class '/usr/[bs]in/tool' '["usr", "usr/bin", "usr/bin/tool"]'
+check_case component_boundary '/usr2/tool' '["usr2", "usr2/tool"]'
+check_case symlink_parent '/linkroot/tool' '["linkroot", "linkroot/tool"]'
