diff --git a/tests/tarfilter-path-dotfiles b/tests/tarfilter-path-dotfiles
new file mode 100755
--- /dev/null
+++ b/tests/tarfilter-path-dotfiles
@@ -0,0 +1,249 @@
+#!/bin/sh
+set -eu
+export LC_ALL=C.UTF-8
+
+MMTARFILTER=${MMTARFILTER:-}
+if [ -z "$MMTARFILTER" ] && [ -x ./tarfilter ]; then
+  MMTARFILTER=./tarfilter
+fi
+if [ -z "$MMTARFILTER" ] && [ -x /usr/bin/mmtarfilter ]; then
+  MMTARFILTER=/usr/bin/mmtarfilter
+fi
+[ -n "$MMTARFILTER" ]
+
+python3 - "$MMTARFILTER" <<'PY'
+import io
+import subprocess
+import sys
+import tarfile
+
+mmtarfilter = sys.argv[1]
+
+
+def archive_bytes(entries):
+    output = io.BytesIO()
+    with tarfile.open(fileobj=output, mode="w", format=tarfile.PAX_FORMAT) as archive:
+        for member, payload in entries:
+            archive.addfile(member, None if payload is None else io.BytesIO(payload))
+    return output.getvalue()
+
+
+def regular(name, payload, mode=0o640, pax=None):
+    member = tarfile.TarInfo(name)
+    member.mode = mode
+    member.uid = 123
+    member.gid = 456
+    member.mtime = 946684800
+    member.size = len(payload)
+    member.pax_headers = dict(pax or {})
+    return member, payload
+
+
+def directory(name, mode=0o751, pax=None):
+    member = tarfile.TarInfo(name)
+    member.type = tarfile.DIRTYPE
+    member.mode = mode
+    member.uid = 123
+    member.gid = 456
+    member.mtime = 946684800
+    member.pax_headers = dict(pax or {})
+    return member, None
+
+
+def symlink(name, target, mode=0o777, pax=None):
+    member = tarfile.TarInfo(name)
+    member.type = tarfile.SYMTYPE
+    member.linkname = target
+    member.mode = mode
+    member.uid = 123
+    member.gid = 456
+    member.mtime = 946684800
+    member.pax_headers = dict(pax or {})
+    return member, None
+
+
+def hardlink(name, target, mode=0o644, pax=None):
+    member = tarfile.TarInfo(name)
+    member.type = tarfile.LNKTYPE
+    member.linkname = target
+    member.mode = mode
+    member.uid = 123
+    member.gid = 456
+    member.mtime = 946684800
+    member.pax_headers = dict(pax or {})
+    return member, None
+
+
+def run_filter(source, *options):
+    result = subprocess.run(
+        [sys.executable, mmtarfilter, *options],
+        input=source,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+    )
+    if result.returncode:
+        sys.stderr.buffer.write(result.stderr)
+        raise SystemExit(result.returncode)
+    return result.stdout
+
+
+def members_by_name(result):
+    with tarfile.open(fileobj=io.BytesIO(result), mode="r:*") as archive:
+        return {member.name: member for member in archive.getmembers()}
+
+
+def regular_payload(result, name):
+    with tarfile.open(fileobj=io.BytesIO(result), mode="r:*") as archive:
+        member = archive.getmember(name)
+        with archive.extractfile(member) as stream:
+            return stream.read()
+
+
+spellings = (
+    ".config",
+    "config",
+    "..name",
+    "...name",
+    "./.config",
+    "./config",
+    "././.config",
+    "././config",
+    "/./.config",
+    "///.config",
+    "/config",
+    "//config",
+    "../config",
+    "./../config",
+)
+source = archive_bytes(
+    [regular(name, f"member-{index}:{name}\n".encode()) for index, name in enumerate(spellings)]
+)
+dotfiles = {".config", "./.config", "././.config", "/./.config", "///.config"}
+plain = {"config", "./config", "././config", "/config", "//config"}
+identity_controls = {"..name", "...name", "../config", "./../config"}
+
+names = set(members_by_name(run_filter(source, "--path-exclude=/.config")))
+assert dotfiles.isdisjoint(names), names
+assert plain <= names, names
+assert identity_controls <= names, names
+
+names = set(members_by_name(run_filter(source, "--path-exclude=/config")))
+assert plain.isdisjoint(names), names
+assert dotfiles <= names, names
+assert identity_controls <= names, names
+
+names = set(
+    members_by_name(
+        run_filter(source, "--path-exclude=/*", "--path-include=/.config")
+    )
+)
+assert names == dotfiles, names
+
+names = set(
+    members_by_name(
+        run_filter(source, "--path-include=/.config", "--path-exclude=/*")
+    )
+)
+assert not names, names
+
+names = set(
+    members_by_name(
+        run_filter(source, "--path-exclude=/*", "--path-include=/..name")
+    )
+)
+assert names == {"..name"}, names
+
+root_spellings = (".", "./", "./.", "/.", "/./", "//", "//./.")
+root_source = archive_bytes([directory(name) for name in root_spellings])
+root_names = set(members_by_name(run_filter(root_source, "--path-exclude=/")))
+assert not root_names, root_names
+
+metadata_source = archive_bytes(
+    [
+        regular(
+            "./.config",
+            b"dotfile-payload\n",
+            mode=0o604,
+            pax={"unit20.kind": "dotfile"},
+        ),
+        regular(
+            "./config",
+            b"plain-payload\n",
+            mode=0o640,
+            pax={"unit20.kind": "plain"},
+        ),
+        directory(
+            "./.cache",
+            mode=0o701,
+            pax={"unit20.kind": "directory"},
+        ),
+        symlink(
+            "./.config-link",
+            ".config",
+            mode=0o777,
+            pax={"unit20.kind": "symlink"},
+        ),
+        hardlink(
+            "./.config-hardlink",
+            "./config",
+            mode=0o644,
+            pax={"unit20.kind": "hardlink"},
+        ),
+    ]
+)
+filtered = run_filter(metadata_source, "--path-exclude=/.config")
+retained = members_by_name(filtered)
+assert set(retained) == {
+    "./config",
+    "./.cache",
+    "./.config-link",
+    "./.config-hardlink",
+}, retained
+assert retained["./config"].isfile()
+assert retained["./config"].mode == 0o640
+assert retained["./config"].uid == 123
+assert retained["./config"].gid == 456
+assert retained["./config"].mtime == 946684800
+assert retained["./config"].pax_headers["unit20.kind"] == "plain"
+assert regular_payload(filtered, "./config") == b"plain-payload\n"
+assert retained["./.cache"].isdir()
+assert retained["./.cache"].mode == 0o701
+assert retained["./.cache"].uid == 123
+assert retained["./.cache"].gid == 456
+assert retained["./.cache"].pax_headers["unit20.kind"] == "directory"
+assert retained["./.config-link"].issym()
+assert retained["./.config-link"].linkname == ".config"
+assert retained["./.config-link"].uid == 123
+assert retained["./.config-link"].gid == 456
+assert retained["./.config-link"].pax_headers["unit20.kind"] == "symlink"
+assert retained["./.config-hardlink"].islnk()
+assert retained["./.config-hardlink"].linkname == "./config"
+assert retained["./.config-hardlink"].uid == 123
+assert retained["./.config-hardlink"].gid == 456
+assert retained["./.config-hardlink"].pax_headers["unit20.kind"] == "hardlink"
+
+retained = members_by_name(run_filter(metadata_source, "--path-exclude=/.cache"))
+assert "./.cache" not in retained, retained
+assert {
+    "./.config",
+    "./config",
+    "./.config-link",
+    "./.config-hardlink",
+} <= set(retained), retained
+
+retained = members_by_name(run_filter(metadata_source, "--path-exclude=/.config-link"))
+assert "./.config-link" not in retained, retained
+assert {
+    "./.config",
+    "./config",
+    "./.cache",
+    "./.config-hardlink",
+} <= set(retained), retained
+
+retained = members_by_name(
+    run_filter(metadata_source, "--path-exclude=/.config-hardlink")
+)
+assert "./.config-hardlink" not in retained, retained
+assert {"./.config", "./config", "./.cache", "./.config-link"} <= set(retained), retained
+PY
