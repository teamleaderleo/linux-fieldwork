#!/bin/sh
set -eu
export LC_ALL=C.UTF-8

MMTARFILTER=${MMTARFILTER:-}
[ -n "$MMTARFILTER" ] || [ ! -x /usr/bin/mmtarfilter ] || MMTARFILTER=/usr/bin/mmtarfilter
[ -n "$MMTARFILTER" ] || [ ! -x ./tarfilter ] || MMTARFILTER=./tarfilter
[ -n "$MMTARFILTER" ]

python3 - "$MMTARFILTER" <<'PY'
import io
import subprocess
import sys
import tarfile

mmtarfilter = sys.argv[1]
members = (
    ".config",
    "config",
    "..name",
    "...name",
    "./.config",
    "./config",
    "././.config",
    "././config",
    "/./.config",
    "/config",
    "../config",
)
dotfiles = {".config", "./.config", "././.config", "/./.config"}
plain = {"config", "./config", "././config", "/config"}


def fixture():
    output = io.BytesIO()
    with tarfile.open(fileobj=output, mode="w", format=tarfile.PAX_FORMAT) as archive:
        for index, name in enumerate(members):
            payload = f"member-{index}:{name}\n".encode()
            member = tarfile.TarInfo(name)
            member.mode = 0o644
            member.size = len(payload)
            archive.addfile(member, io.BytesIO(payload))
    return output.getvalue()


def filtered_names(*options):
    result = subprocess.run(
        [sys.executable, mmtarfilter, *options],
        input=fixture(),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode:
        sys.stderr.buffer.write(result.stderr)
        raise SystemExit(result.returncode)
    with tarfile.open(fileobj=io.BytesIO(result.stdout), mode="r:*") as archive:
        return set(archive.getnames())


names = filtered_names("--path-exclude=/.config")
assert dotfiles.isdisjoint(names), names
assert plain <= names, names
assert {"..name", "...name", "../config"} <= names, names

names = filtered_names("--path-exclude=/config")
assert plain.isdisjoint(names), names
assert dotfiles <= names, names
assert {"..name", "...name", "../config"} <= names, names

names = filtered_names("--path-exclude=/*", "--path-include=/.config")
assert names == dotfiles, names

names = filtered_names("--path-exclude=/*", "--path-include=/..name")
assert names == {"..name"}, names
PY
