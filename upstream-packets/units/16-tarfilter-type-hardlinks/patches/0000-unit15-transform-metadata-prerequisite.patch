+def _find_unescaped_delimiter(expression, delimiter, start):
+    backslashes = 0
+    for index in range(start, len(expression)):
+        char = expression[index]
+        if char == "\\":
+            backslashes += 1
+            continue
+        if char == delimiter and backslashes % 2 == 0:
+            return index
+        backslashes = 0
+    return -1
+
+
+def _unescape_delimiter(value, delimiter):
+    result = []
+    index = 0
+    while index < len(value):
+        if (
+            value[index] == "\\"
+            and index + 1 < len(value)
+            and value[index + 1] == delimiter
+        ):
+            result.append(delimiter)
+            index += 2
+            continue
+        result.append(value[index])
+        index += 1
+    return "".join(result)
+
+
+def _sed_replacement(template, delimiter):
+    def replace(match):
+        result = []
+        index = 0
+        while index < len(template):
+            char = template[index]
+            if char == "&":
+                result.append(match.group(0))
+                index += 1
+                continue
+            if char != "\\":
+                result.append(char)
+                index += 1
+                continue
+            if index + 1 == len(template):
+                result.append("\\")
+                index += 1
+                continue
+            escaped = template[index + 1]
+            if escaped in "123456789":
+                group = match.group(int(escaped))
+                if group is not None:
+                    result.append(group)
+            elif escaped in ("&", "\\", delimiter):
+                result.append(escaped)
+            else:
+                result.append(escaped)
+            index += 2
+        return "".join(result)
+
+    return replace
+
+
+def _sed_substitute(regex, replacement, value, occurrence, global_after):
+    selected = occurrence if occurrence > 0 else 1
+    seen = 0
+
+    def replace_selected(match):
+        nonlocal seen
+        seen += 1
+        if seen < selected:
+            return match.group(0)
+        if seen == selected or global_after:
+            return replacement(match)
+        return match.group(0)
+
+    return regex.sub(replace_selected, value)
+
