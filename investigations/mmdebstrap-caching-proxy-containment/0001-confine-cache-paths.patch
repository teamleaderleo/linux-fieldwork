+def cache_path(root, request_target, host):
+    parsed = urllib.parse.urlsplit(request_target)
+    if (
+        parsed.scheme != "http"
+        or parsed.netloc != host
+        or parsed.query
+        or parsed.fragment
+        or not parsed.path.startswith("/")
+    ):
+        raise ValueError("invalid proxy request target")
+    raw_path = parsed.path[1:]
+    lowered = raw_path.lower()
+    if not raw_path or "%2f" in lowered or "%5c" in lowered:
+        raise ValueError("unsafe cache path")
+    decoded = urllib.parse.unquote(raw_path)
+    if "\0" in decoded or decoded.startswith("/") or "//" in decoded:
+        raise ValueError("unsafe cache path")
+    relative = pathlib.PurePosixPath(decoded)
+    if any(part in (".", "..") for part in relative.parts):
+        raise ValueError("unsafe cache path")
+    root = root.resolve()
+    candidate = (root / pathlib.Path(*relative.parts)).resolve()
+    if candidate == root or not candidate.is_relative_to(root):
+        raise ValueError("unsafe cache path")
+    return candidate
+
