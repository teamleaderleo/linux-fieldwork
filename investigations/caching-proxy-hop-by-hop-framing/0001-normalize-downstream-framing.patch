@@ -14,6 +14,39 @@ oldcachedir = None
 newcachedir = None
 readonly = False
 
+HOP_BY_HOP_HEADERS = {
+    "connection",
+    "keep-alive",
+    "proxy-authenticate",
+    "proxy-authorization",
+    "proxy-connection",
+    "te",
+    "trailer",
+    "transfer-encoding",
+    "upgrade",
+}
+
+
+def downstream_headers(response):
+    headers = response.getheaders()
+    connection_tokens = set()
+    for name, value in headers:
+        if name.lower() == "connection":
+            connection_tokens.update(
+                token.strip().lower()
+                for token in value.split(",")
+                if token.strip()
+            )
+    blocked = HOP_BY_HOP_HEADERS | connection_tokens
+    if response.chunked:
+        # http.client removes upstream chunk framing from read(). A forwarded
+        # Content-Length would therefore conflict with the framing that owned
+        # the upstream message when both headers were present.
+        blocked = blocked | {"content-length"}
+    return [
+        (name, value)
+        for name, value in headers
+        if name.lower() not in blocked
+    ]
+
 
 class ProxyRequestHandler(http.server.BaseHTTPRequestHandler):
     def do_GET(self):
