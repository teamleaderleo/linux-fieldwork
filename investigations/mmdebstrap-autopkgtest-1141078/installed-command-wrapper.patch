diff --git a/debian/tests/testsuite b/debian/tests/testsuite
--- a/debian/tests/testsuite
+++ b/debian/tests/testsuite
@@ -140,11 +140,27 @@ trap "kill $HTTPD_PID" INT QUIT TERM EXIT
-# create a fake mmdebstrap file in the current directory that coverage.sh can
-# copy
-cat << END > ./mmdebstrap
+# create a formatted proxy in the current directory so that coverage.sh checks
+# this source while every behavioral invocation reaches the installed package
+cat << 'END' > ./mmdebstrap
 #!/usr/bin/perl
 use strict;
 use warnings;
-exit(1)
+use English qw(-no_match_vars);
+
+exec '/usr/bin/mmdebstrap', @ARGV
+  or die "cannot exec /usr/bin/mmdebstrap: $OS_ERROR\n";
+
+__END__
+
+=head1 NAME
+
+mmdebstrap - proxy to the installed package under test
+
+=head1 DESCRIPTION
+
+Forwards all arguments to F</usr/bin/mmdebstrap>.
+
+=cut
 END
+chmod 0755 ./mmdebstrap
 
