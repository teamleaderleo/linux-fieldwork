diff --git a/debian/tests/testsuite b/debian/tests/testsuite
--- a/debian/tests/testsuite
+++ b/debian/tests/testsuite
@@ -146,6 +146,14 @@ cat << END > ./mmdebstrap
 exit(1)
 END
 
+# Exercise the installed command while keeping coverage.sh from applying the
+# source tree's style gate to a package built with an older perltidy release.
+cat << 'END' > ./mmdebstrap-under-test
+#!/bin/sh
+exec /usr/bin/mmdebstrap "$@"
+END
+chmod 0755 ./mmdebstrap-under-test
+
 # must not be used during testing -- installed version must be used instead
 cat << END > ./tarfilter
 #!/usr/bin/env python3
@@ -175,7 +183,7 @@ fi
 # HAVE_QEMU=no because there is no kvm kernel module
 # HAVE_BINFMT=no because there is no binfmt_misc kernel module
 ret=0
-timeout $TIMEOUT runuser -u "$AUTOPKGTEST_NORMAL_USER" -- env CMD="mmdebstrap --setup-hook=$SRC/debian/tests/sourcesfilter --hook-dir=$SRC/hooks/file-mirror-automount" DEFAULT_DIST=$DEFAULT_DIST RUN_MA_SAME_TESTS=$RUN_MA_SAME_TESTS HAVE_QEMU=no HAVE_BINFMT=no USE_HOST_APT_CONFIG=yes "$SRC/coverage.sh" --exitfirst || ret=$?
+timeout $TIMEOUT runuser -u "$AUTOPKGTEST_NORMAL_USER" -- env CMD="./mmdebstrap-under-test --setup-hook=$SRC/debian/tests/sourcesfilter --hook-dir=$SRC/hooks/file-mirror-automount" DEFAULT_DIST=$DEFAULT_DIST RUN_MA_SAME_TESTS=$RUN_MA_SAME_TESTS HAVE_QEMU=no HAVE_BINFMT=no USE_HOST_APT_CONFIG=yes "$SRC/coverage.sh" --exitfirst || ret=$?
 if [ "$ret" -eq 124 ]; then
 	echo "command timed out after $TIMEOUT seconds" >&2
 	exit 77
