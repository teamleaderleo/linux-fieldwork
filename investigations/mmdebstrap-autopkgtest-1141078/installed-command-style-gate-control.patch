+timeout $TIMEOUT runuser -u "$AUTOPKGTEST_NORMAL_USER" -- env SKIP_MMSCRIPT_CHECKS=yes CMD="mmdebstrap --setup-hook=$SRC/debian/tests/sourcesfilter --hook-dir=$SRC/hooks/file-mirror-automount" DEFAULT_DIST=$DEFAULT_DIST RUN_MA_SAME_TESTS=$RUN_MA_SAME_TESTS HAVE_QEMU=no HAVE_BINFMT=no USE_HOST_APT_CONFIG=yes "$SRC/coverage.sh" --exitfirst || ret=$?
 if [ "$ret" -eq 124 ]; then
