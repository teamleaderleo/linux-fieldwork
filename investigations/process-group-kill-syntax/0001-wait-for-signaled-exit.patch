+    def test_marked_handler_settles_before_liveness_snapshot(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            marker = pathlib.Path(temporary) / "signal.marker"
+            process = subprocess.Popen(
+                [
+                    sys.executable,
+                    "-c",
+                    (
+                        "import pathlib, sys, time; "
+                        "pathlib.Path(sys.argv[1]).write_text('2', encoding='utf-8'); "
+                        "time.sleep(0.25)"
+                    ),
+                    str(marker),
+                ]
+            )
+            try:
+                deadline = time.monotonic() + 2
+                while time.monotonic() < deadline and not marker.exists():
+                    time.sleep(0.01)
+                self.assertTrue(marker.exists())
+                self.assertTrue(process_running(process.pid))
+
+                wait_for_marked_process_exit(process.pid, marker)
+
+                self.assertFalse(process_running(process.pid))
+            finally:
+                try:
+                    process.wait(timeout=1)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+                    process.wait(timeout=1)
