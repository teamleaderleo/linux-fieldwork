+sub normalize_directory_mtimes {
+    my $directory = shift;
+    my $timestamp = shift;
+
+    my @rootstat = lstat $directory;
+    scalar @rootstat or error "cannot stat $directory";
+    my $rootdev = $rootstat[0];
+
+    my $normalize = sub {
+        my @stat = lstat $File::Find::name;
+        scalar @stat or error "cannot stat $File::Find::name";
+        return if not -d _;
+        if ($stat[0] != $rootdev) {
+            $File::Find::prune = 1;
+            return;
+        }
+        1 == utime($timestamp, $timestamp, $File::Find::name)
+          or error "cannot set mtime on $File::Find::name";
+    };
+
+    find({ wanted => $normalize, no_chdir => 1 }, $directory);
+}
