+/// Convert a normalized POSIX timespec to SystemTime without losing
+/// timestamps before the Unix epoch.
+fn system_time_from_timespec(secs: i64, nsecs: u32) -> SystemTime {
+    let nsecs = nsecs.min(999_999_999);
+    if secs >= 0 {
+        UNIX_EPOCH + Duration::new(secs as u64, nsecs)
+    } else if nsecs == 0 {
+        UNIX_EPOCH - Duration::new(secs.unsigned_abs(), 0)
+    } else {
+        UNIX_EPOCH
+            - Duration::new(secs.unsigned_abs() - 1, 1_000_000_000 - nsecs)
+    }
+}
+
+/// Convert SystemTime back to a normalized signed POSIX timespec.
+fn timespec_from_system_time(t: SystemTime) -> libc::timespec {
+    let (secs, nsecs) = match t.duration_since(UNIX_EPOCH) {
+        Ok(d) => {
+            let secs = i64::try_from(d.as_secs()).unwrap_or(i64::MAX);
+            let nsecs = if secs == i64::MAX && d.as_secs() > i64::MAX as u64 {
+                999_999_999
+            } else {
+                d.subsec_nanos()
+            };
+            (secs, nsecs)
+        }
+        Err(e) => {
+            let d = e.duration();
+            let secs = d.as_secs();
+            let nsecs = d.subsec_nanos();
+            if (secs, nsecs) >= (i64::MAX as u64 + 1, 0) {
+                (i64::MIN, 0)
+            } else if nsecs == 0 {
+                (-(secs as i64), 0)
+            } else {
+                (-(secs as i64) - 1, 1_000_000_000 - nsecs)
+            }
+        }
+    };
+    libc::timespec {
+        tv_sec: secs as _,
+        tv_nsec: nsecs as _,
+    }
+}
