diff --git a/upstream/mmdebstrap/run_qemu.sh b/upstream/mmdebstrap/run_qemu.sh
--- a/upstream/mmdebstrap/run_qemu.sh
+++ b/upstream/mmdebstrap/run_qemu.sh
@@ -6,6 +6,7 @@
 : "${cachedir:=./shared/cache}"
 : "${MMDEBSTRAP_TESTS_DEBUG:=no}"
 tmpdir="$(mktemp -d)"
+cleanup_signal_status=0
 
 finish() {
   rv=$1
@@ -30,6 +31,11 @@
       [ "$cleanup_status" -ne 0 ] || cleanup_status=$status
     }
   fi
+
+  trap '' INT TERM
+  if [ "$rv" -eq 0 ] && [ "$cleanup_signal_status" -ne 0 ]; then
+    rv=$cleanup_signal_status
+  fi
 
   if [ "$rv" -ne 0 ]; then
     exit "$rv"
@@ -41,10 +47,18 @@
   exit "$cleanup_status"
 }
 
+record_cleanup_signal() {
+  if [ "$cleanup_signal_status" -eq 0 ]; then
+    cleanup_signal_status=$1
+  fi
+}
+
 cleanup_exit() {
   rv=$?
-  trap '' INT TERM
+  trap 'record_cleanup_signal 130' INT
+  trap 'record_cleanup_signal 143' TERM
   trap - EXIT
   finish "$rv"
 }
