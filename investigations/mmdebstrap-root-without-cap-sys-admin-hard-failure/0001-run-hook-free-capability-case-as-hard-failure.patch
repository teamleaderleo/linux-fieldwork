diff --git a/debian/tests/testsuite b/debian/tests/testsuite
--- a/debian/tests/testsuite
+++ b/debian/tests/testsuite
@@ -205,6 +205,33 @@ if [ "$ret" -ne 0 ]; then
 # subtract 10 seconds to account for the inaccuracy in measuring time
 TIMEOUT=$((10000-$(date +%s)+$TIME_BEGIN-10))
 
+# run hook-free tests whose failures remain authoritative for the package test
+grep_status=0
+HOOK_FREE_HARD_TESTS=$(grep-dctrl --exact-match --field Needs-Hook-Free-APT-Config true --no-field-names --show-field=Test < coverage.txt) || grep_status=$?
+if [ "$grep_status" -gt 1 ]; then
+	echo "failed to select hook-free hard-failure tests: grep-dctrl status $grep_status" >&2
+	exit "$grep_status"
+fi
+if [ -z "$HOOK_FREE_HARD_TESTS" ]; then
+	echo "no hook-free hard-failure tests were selected" >&2
+	exit 1
+fi
+if [ "$TIMEOUT" -le 0 ]; then
+	echo "no time remains for hook-free hard-failure tests" >&2
+	exit 77
+fi
+ret=0
+timeout $TIMEOUT runuser -u "$AUTOPKGTEST_NORMAL_USER" -- env CMD="mmdebstrap" DEFAULT_DIST=$DEFAULT_DIST RUN_MA_SAME_TESTS=no HAVE_QEMU=no HAVE_BINFMT=no http_proxy= "$SRC/coverage.py" --exitfirst $HOOK_FREE_HARD_TESTS || ret=$?
+if [ "$ret" -eq 124 ]; then
+	echo "hook-free hard-failure tests timed out after $TIMEOUT seconds" >&2
+	exit 77
+elif [ "$ret" -ne 0 ]; then
+	exit "$ret"
+fi
+
+# subtract 10 seconds to account for the inaccuracy in measuring time
+TIMEOUT=$((10000-$(date +%s)+$TIME_BEGIN-10))
+
