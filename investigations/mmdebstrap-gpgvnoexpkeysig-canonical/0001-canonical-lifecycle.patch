--- a/upstream/mmdebstrap/gpgvnoexpkeysig
+++ b/upstream/mmdebstrap/gpgvnoexpkeysig
@@ -28,17 +28,41 @@
 set -eu
 
 find_gpgv_status_fd() {
+  status_fd=1
   while [ "$#" -gt 0 ]; do
-    if [ "$1" = '--status-fd' ]; then
-      echo "$2"
-      return 0
-    fi
-    shift
+    case $1 in
+      --)
+        break
+        ;;
+      --status-fd)
+        if [ "$#" -lt 2 ]; then
+          return 1
+        fi
+        candidate=$2
+        shift 2
+        ;;
+      --status-fd=*)
+        candidate=${1#--status-fd=}
+        shift
+        ;;
+      *)
+        shift
+        continue
+        ;;
+    esac
+    case $candidate in
+      '' | *[!0-9]*) return 1 ;;
+    esac
+    # Match gpgv option precedence: the last valid occurrence wins.
+    status_fd=$candidate
   done
-  # default fd is stdout
-  echo 1
+  echo "$status_fd"
 }
-GPGSTATUSFD="$(find_gpgv_status_fd "$@")"
+
+if ! GPGSTATUSFD="$(find_gpgv_status_fd "$@")"; then
+  echo "invalid --status-fd argument" >&2
+  exit 1
+fi
 
 case $GPGSTATUSFD in
   '' | *[!0-9]*)
@@ -52,5 +76,174 @@ if ! command -v gpgv >&2; then
   exit 1
 fi
 
-# we need eval because we cannot redirect a variable fd
-eval 'exec gpgv "$@" '"$GPGSTATUSFD"'>&1 | sed "s/^\[GNUPG:\] EXPKEYSIG /[GNUPG:] GOODSIG /" >&'"$GPGSTATUSFD"
+# A regular status spool keeps filter failure from feeding back into gpgv.
+FILTER_DIR=$(mktemp -d "${TMPDIR:-/tmp}/gpgvnoexpkeysig.XXXXXXXXXX")
+STATUS_FILE="$FILTER_DIR/status"
+GPGV_PID=
+FILTER_PID=
+FILTER_STARTED=no
+PENDING_STATUS=
+PENDING_SIGNAL=
+
+record_signal() {
+  PENDING_STATUS=$1
+  PENDING_SIGNAL=$2
+}
+
+install_recording_traps() {
+  trap 'record_signal 129 1' HUP
+  trap 'record_signal 130 2' INT
+  trap 'record_signal 143 15' TERM
+}
+
+install_forwarding_traps() {
+  trap 'signal_exit 129 1' HUP
+  trap 'signal_exit 130 2' INT
+  trap 'signal_exit 143 15' TERM
+}
+
+run_gpgv_child() {
+  trap - HUP INT TERM
+  eval 'exec gpgv "$@" '"$GPGSTATUSFD"'>"$STATUS_FILE"'
+}
+
+run_filter_child() {
+  trap - HUP INT TERM
+  eval 'exec sed "s/^\[GNUPG:\] EXPKEYSIG /[GNUPG:] GOODSIG /" <"$STATUS_FILE" >&'"$GPGSTATUSFD"
+}
+
+cleanup_files() {
+  cleanup_result=0
+  if rm -f "$STATUS_FILE"; then
+    :
+  else
+    cleanup_result=$?
+  fi
+  if rmdir "$FILTER_DIR"; then
+    :
+  else
+    result=$?
+    if [ "$cleanup_result" -eq 0 ]; then
+      cleanup_result=$result
+    fi
+  fi
+  return "$cleanup_result"
+}
+
+emergency_cleanup() {
+  trap - EXIT
+  trap '' HUP INT TERM
+  if [ -n "$GPGV_PID" ] && kill -0 "$GPGV_PID" 2>/dev/null; then
+    kill "$GPGV_PID" 2>/dev/null || :
+  fi
+  if [ -n "$FILTER_PID" ] && kill -0 "$FILTER_PID" 2>/dev/null; then
+    kill "$FILTER_PID" 2>/dev/null || :
+  fi
+  if [ -n "$GPGV_PID" ]; then
+    wait "$GPGV_PID" 2>/dev/null || :
+    GPGV_PID=
+  fi
+  if [ -n "$FILTER_PID" ]; then
+    wait "$FILTER_PID" 2>/dev/null || :
+    FILTER_PID=
+  fi
+  cleanup_files || :
+}
+
+signal_exit() {
+  signal_status=$1
+  signal_number=$2
+  trap - EXIT
+  trap '' HUP INT TERM
+  PENDING_STATUS=
+  PENDING_SIGNAL=
+
+  if [ -n "$GPGV_PID" ] && kill -0 "$GPGV_PID" 2>/dev/null; then
+    kill -"$signal_number" "$GPGV_PID" 2>/dev/null || :
+  fi
+  if [ -n "$FILTER_PID" ] && kill -0 "$FILTER_PID" 2>/dev/null; then
+    kill -"$signal_number" "$FILTER_PID" 2>/dev/null || :
+  fi
+  if [ -n "$GPGV_PID" ]; then
+    wait "$GPGV_PID" 2>/dev/null || :
+    GPGV_PID=
+  fi
+  if [ -n "$FILTER_PID" ]; then
+    wait "$FILTER_PID" 2>/dev/null || :
+    FILTER_PID=
+  fi
+
+  if [ "$FILTER_STARTED" = no ] && [ -s "$STATUS_FILE" ]; then
+    run_filter_child &
+    FILTER_PID=$!
+    wait "$FILTER_PID" 2>/dev/null || :
+    FILTER_PID=
+  fi
+  cleanup_files || :
+  exit "$signal_status"
+}
+
+run_pending_signal() {
+  if [ -n "$PENDING_STATUS" ]; then
+    pending_status=$PENDING_STATUS
+    pending_signal=$PENDING_SIGNAL
+    PENDING_STATUS=
+    PENDING_SIGNAL=
+    signal_exit "$pending_status" "$pending_signal"
+  fi
+}
+
+start_gpgv() {
+  PENDING_STATUS=
+  PENDING_SIGNAL=
+  install_recording_traps
+  run_gpgv_child "$@" &
+  GPGV_PID=$!
+  install_forwarding_traps
+  run_pending_signal
+}
+
+start_filter() {
+  PENDING_STATUS=
+  PENDING_SIGNAL=
+  install_recording_traps
+  run_filter_child &
+  FILTER_PID=$!
+  FILTER_STARTED=yes
+  install_forwarding_traps
+  run_pending_signal
+}
+
+trap emergency_cleanup EXIT
+install_forwarding_traps
+
+start_gpgv "$@"
+if wait "$GPGV_PID"; then
+  GPGV_STATUS=0
+else
+  GPGV_STATUS=$?
+fi
+GPGV_PID=
+
+start_filter
+if wait "$FILTER_PID"; then
+  FILTER_STATUS=0
+else
+  FILTER_STATUS=$?
+fi
+FILTER_PID=
+
+trap - EXIT
+if cleanup_files; then
+  CLEANUP_STATUS=0
+else
+  CLEANUP_STATUS=$?
+fi
+
+if [ "$GPGV_STATUS" -ne 0 ]; then
+  exit "$GPGV_STATUS"
+fi
+if [ "$FILTER_STATUS" -ne 0 ]; then
+  exit "$FILTER_STATUS"
+fi
+exit "$CLEANUP_STATUS"
