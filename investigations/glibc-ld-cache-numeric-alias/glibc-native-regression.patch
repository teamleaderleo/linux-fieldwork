+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <https://www.gnu.org/licenses/>.  */
+
+#include <dlfcn.h>
+#include <stdlib.h>
+
+#include <support/check.h>
+#include <support/support.h>
+#include <support/xdlfcn.h>
+#include <support/xunistd.h>
+
+static void
+run_ldconfig (void)
+{
+  char *command = xasprintf ("%s/ldconfig", support_install_rootsbindir);
+  TEST_COMPARE (system (command), 0);
+  free (command);
+}
+
+static int
+load_marker (const char *name)
+{
+  void *handle = xdlopen (name, RTLD_NOW | RTLD_LOCAL);
+  int (*marker) (void) = xdlsym (handle, "cache_alias_marker");
+  int result = marker ();
+  xdlclose (handle);
+  return result;
+}
+
+static void
+copy_module (const char *source_name, const char *target_name)
+{
+  char *source = xasprintf ("%s/elf/%s", support_objdir_root, source_name);
+  support_copy_file (source, target_name);
+  free (source);
+}
+
+static int
+do_test (void)
+{
+  xmkdirp ("/glibc-test/cache-name-a", 0777);
+  xmkdirp ("/glibc-test/cache-name-b", 0777);
+
+  copy_module ("libcachealias-1.so",
+               "/glibc-test/cache-name-a/libcachealias-a.so.1.0");
+  copy_module ("libcachealias-01.so",
+               "/glibc-test/cache-name-b/libcachealias-b.so.1.0");
+
+  xmkdirp (support_sysconfdir_prefix, 0777);
+  char *conf_path = xasprintf ("%s/ld.so.conf", support_sysconfdir_prefix);
+  support_write_file_string (conf_path,
+                             "/glibc-test/cache-name-a\n"
+                             "/glibc-test/cache-name-b\n");
+  free (conf_path);
+
+  run_ldconfig ();
+
+  /* Numeric ordering is useful for the cache, but the two SONAMEs are
+     distinct byte strings and must remain distinct lookup identities.  */
+  TEST_COMPARE (load_marker ("libcachealias.so.1"), 1);
+  TEST_COMPARE (load_marker ("libcachealias.so.01"), 2);
+
+  /* A comparator-equivalent spelling which is not present must not become
+     a cache alias for either installed SONAME.  */
+  void *absent = dlopen ("libcachealias.so.001", RTLD_NOW | RTLD_LOCAL);
+  TEST_VERIFY (absent == NULL);
+  if (absent != NULL)
+    xdlclose (absent);
+
+  return 0;
+}
+
+#include <support/test-driver.c>
