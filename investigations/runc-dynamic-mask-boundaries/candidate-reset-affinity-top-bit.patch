diff --git a/libcontainer/process_linux_test.go b/libcontainer/process_linux_test.go
new file mode 100644
--- /dev/null
+++ b/libcontainer/process_linux_test.go
@@ -0,0 +1,25 @@
+package libcontainer
+
+import (
+	"testing"
+
+	"golang.org/x/sys/unix"
+
+	"github.com/opencontainers/runc/libcontainer/configs"
+)
+
+func TestResetCPUAffinityMaskIncludesMaxCPU(t *testing.T) {
+	oldMask := unix.NewCPUSet(configs.MaxCPU)
+	oldMask.Fill()
+	if oldMask.IsSet(configs.MaxCPU) {
+		t.Fatalf("exclusive control unexpectedly contains CPU %d", configs.MaxCPU)
+	}
+
+	mask := newResetCPUAffinityMask()
+	if !mask.IsSet(configs.MaxCPU) {
+		t.Fatalf("reset mask does not contain accepted CPU %d", configs.MaxCPU)
+	}
+	if len(mask) <= len(oldMask) {
+		t.Fatalf("reset mask did not grow past exclusive control: new=%d old=%d", len(mask), len(oldMask))
+	}
+}
