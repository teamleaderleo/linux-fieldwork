diff --git a/upstream/mmdebstrap/make_mirror.sh b/upstream/mmdebstrap/make_mirror.sh
--- a/upstream/mmdebstrap/make_mirror.sh
+++ b/upstream/mmdebstrap/make_mirror.sh
@@ -337,3 +337,68 @@
-./caching_proxy.py "$oldcachedir" "$newcachedir" &
-PROXYPID=$!
-trap 'kill "$PROXYPID" || :' EXIT INT TERM
+PROXYPID=
+PENDING_SIGNAL=
+CLEANUP_PROXY_CACHE=no
+CLEANUP_TMPDIR=no
+
+handle_launch_signal() {
+  status=$1
+  if [ -z "${PENDING_SIGNAL:-}" ]; then
+    PENDING_SIGNAL=$status
+  fi
+  if [ -n "${PROXYPID:-}" ]; then
+    signal_exit "$PENDING_SIGNAL"
+  fi
+}
+
+stop_proxy() {
+  if [ -n "${PROXYPID:-}" ]; then
+    if kill -0 "$PROXYPID" 2>/dev/null; then
+      kill "$PROXYPID" 2>/dev/null || :
+    fi
+    wait "$PROXYPID" 2>/dev/null || :
+    PROXYPID=
+  fi
+}
+
+cleanup_owner() {
+  stop_proxy
+  if [ "${CLEANUP_TMPDIR:-no}" = yes ]; then
+    cleanuptmpdir || :
+  fi
+  if [ "${CLEANUP_PROXY_CACHE:-no}" = yes ]; then
+    if [ -L ./shared/cache ] && [ "$(readlink ./shared/cache)" = "$newcache" ]; then
+      CLEANUP_PROXY_CACHE=no
+    else
+      cleanup_newcachedir || :
+    fi
+  fi
+}
+
+signal_exit() {
+  status=$1
+  trap - EXIT INT QUIT TERM
+  cleanup_owner
+  exit "$status"
+}
+
+install_signal_traps() {
+  trap 'signal_exit 130' INT
+  trap 'signal_exit 131' QUIT
+  trap 'signal_exit 143' TERM
+}
+
+launch_proxy() {
+  PENDING_SIGNAL=
+  trap 'handle_launch_signal 130' INT
+  trap 'handle_launch_signal 131' QUIT
+  trap 'handle_launch_signal 143' TERM
+  "$@" &
+  PROXYPID=$!
+  if [ -n "$PENDING_SIGNAL" ]; then
+    signal_exit "$PENDING_SIGNAL"
+  fi
+  install_signal_traps
+}
+
+trap 'cleanup_owner' EXIT
+install_signal_traps
+launch_proxy ./caching_proxy.py "$oldcachedir" "$newcachedir"
@@ -347 +411,0 @@
-  kill $PROXYPID
@@ -351 +415 @@
-trap 'kill "$PROXYPID" || :;cleanup_newcachedir' EXIT INT TERM
+CLEANUP_PROXY_CACHE=yes
@@ -408 +472 @@
-kill $PROXYPID
+stop_proxy
@@ -447,2 +511 @@
-  ./caching_proxy.py --readonly "$oldcachedir" "$newcachedir" &
-  PROXYPID=$!
+  launch_proxy ./caching_proxy.py --readonly "$oldcachedir" "$newcachedir"
@@ -456 +518,0 @@
