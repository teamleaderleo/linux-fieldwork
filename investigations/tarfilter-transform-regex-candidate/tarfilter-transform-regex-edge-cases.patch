+def _quantifier_at(pattern, index):
+    char = pattern[index]
+    if char in "*+?":
+        return char, index + 1
+    if char != "{":
+        return None, index
+    match = re.match(
+        r"\{(?:[0-9]+(?:,[0-9]*)?|,[0-9]+)\}",
+        pattern[index:],
+    )
+    if match is None:
+        return None, index
+    token = match.group(0)
+    return token, index + len(token)
+
+
+def _normalize_repeated_quantifiers(pattern, extended):
+    result = []
+    group_starts = []
+    atom_start = None
+    repeated = False
+    previous_quantifier = None
+    index = 0
+    while index < len(pattern):
+        char = pattern[index]
+        if char == "\\":
+            end = min(index + 2, len(pattern))
+            result.append(pattern[index:end])
+            atom_start = len(result) - 1
+            repeated = False
+            previous_quantifier = None
+            index = end
+            continue
+        if char == "[":
+            expression, index = _copy_bracket_expression(pattern, index)
+            result.append(expression)
+            atom_start = len(result) - 1
+            repeated = False
+            previous_quantifier = None
+            continue
+        if char == "(":
+            group_starts.append(len(result))
+            result.append(char)
+            atom_start = None
+            repeated = False
+            previous_quantifier = None
+            index += 1
+            continue
+        if char == ")":
+            if extended and not group_starts:
+                result.append(r"\)")
+                atom_start = len(result) - 1
+            else:
+                result.append(char)
+                atom_start = group_starts.pop() if group_starts else len(result) - 1
+            repeated = False
+            previous_quantifier = None
+            index += 1
+            continue
+        if char == "|":
+            result.append(char)
+            atom_start = None
+            repeated = False
+            previous_quantifier = None
+            index += 1
+            continue
+        quantifier, next_index = _quantifier_at(pattern, index)
+        if quantifier is not None:
+            if (
+                not extended
+                and repeated
+                and previous_quantifier.startswith("{")
+                and quantifier.startswith("{")
+            ):
+                raise ValueError("consecutive basic-regex intervals are invalid")
+            if atom_start is not None and repeated:
+                nested = "".join(result[atom_start:])
+                result[atom_start:] = ["(?:" + nested + ")"]
+            result.append(quantifier)
+            repeated = True
+            previous_quantifier = quantifier
+            index = next_index
+            continue
+        if char == "{":
+            raise ValueError("invalid active regex interval")
+        result.append(char)
+        atom_start = len(result) - 1
+        repeated = False
+        previous_quantifier = None
+        index += 1
+    return "".join(result)
+
