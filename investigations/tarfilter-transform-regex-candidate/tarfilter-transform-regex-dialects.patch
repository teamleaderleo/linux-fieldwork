+def _active_branch_end(pattern, index, extended):
+    if index == len(pattern):
+        return True
+    if extended:
+        return pattern[index] in ")|"
+    return (
+        index + 1 < len(pattern)
+        and pattern[index] == "\\"
+        and pattern[index + 1] in ")|"
+    )
+
+
+def _copy_bracket_expression(pattern, start):
+    index = start + 1
+    if index < len(pattern) and pattern[index] == "^":
+        index += 1
+    if index < len(pattern) and pattern[index] == "]":
+        index += 1
+
+    while index < len(pattern):
+        if pattern[index] == "\\" and index + 1 < len(pattern):
+            index += 2
+            continue
+        if pattern[index] == "]":
+            expression = pattern[start : index + 1]
+            if any(marker in expression for marker in ("[:", "[.", "[=")):
+                raise ValueError(
+                    "unsupported POSIX bracket class, collating element, "
+                    "or equivalence class"
+                )
+            return expression, index + 1
+        index += 1
+
+    # Preserve the incomplete expression and let re.compile() reject it.
+    return pattern[start:], len(pattern)
+
+
+def _translate_pattern(pattern, extended):
+    result = []
+    index = 0
+    branch_start = True
+    basic_operators = "+?|(){}"
+    unsupported_alpha_escapes = set("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz")
+
+    while index < len(pattern):
+        char = pattern[index]
+
+        if char == "[":
+            expression, index = _copy_bracket_expression(pattern, index)
+            result.append(expression)
+            branch_start = False
+            continue
+
+        if char == "\\":
+            if index + 1 == len(pattern):
+                result.append("\\")
+                index += 1
+                continue
+
+            escaped = pattern[index + 1]
+            if escaped in unsupported_alpha_escapes and escaped not in "123456789":
+                raise ValueError(
+                    "unsupported alphabetic regex escape: \\%s" % escaped
+                )
+
+            if escaped in basic_operators:
+                if extended:
+                    result.append("\\" + escaped)
+                    branch_start = False
+                else:
+                    result.append(escaped)
+                    branch_start = escaped in "(|"
+                index += 2
+                continue
+
+            result.append("\\" + escaped)
+            branch_start = False
+            index += 2
+            continue
+
+        if char == "^":
+            result.append("^" if extended or branch_start else "\\^")
+            branch_start = False
+            index += 1
+            continue
+
+        if char == "$":
+            result.append(
+                "$"
+                if extended or _active_branch_end(pattern, index + 1, extended)
+                else "\\$"
+            )
+            branch_start = False
+            index += 1
+            continue
+
+        if not extended and char in basic_operators:
+            result.append("\\" + char)
+            branch_start = False
+            index += 1
+            continue
+
+        result.append(char)
+        if extended and char in "(|":
+            branch_start = True
+        elif extended and char == ")":
+            branch_start = False
+        elif char not in "*+?}":
+            branch_start = False
+        index += 1
+
+    return "".join(result)
+
