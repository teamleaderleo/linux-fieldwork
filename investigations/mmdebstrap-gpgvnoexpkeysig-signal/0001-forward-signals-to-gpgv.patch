diff --git a/upstream/mmdebstrap/gpgvnoexpkeysig b/upstream/mmdebstrap/gpgvnoexpkeysig
--- a/upstream/mmdebstrap/gpgvnoexpkeysig
+++ b/upstream/mmdebstrap/gpgvnoexpkeysig
@@ -57,32 +57,84 @@
 # we need eval because we cannot redirect a variable fd
 FILTER_DIR=$(mktemp -d "${TMPDIR:-/tmp}/gpgvnoexpkeysig.XXXXXXXXXX")
 STATUS_FILE="$FILTER_DIR/status"
+GPGV_PID=
+FILTER_PID=
+
+start_filter() {
+  eval 'sed "s/^\[GNUPG:\] EXPKEYSIG /[GNUPG:] GOODSIG /" <"$STATUS_FILE" >&'"$GPGSTATUSFD" &
+  FILTER_PID=$!
+}
 
 cleanup() {
+  if [ -n "$GPGV_PID" ] && kill -0 "$GPGV_PID" 2>/dev/null; then
+    kill "$GPGV_PID" 2>/dev/null || :
+  fi
+  if [ -n "$FILTER_PID" ] && kill -0 "$FILTER_PID" 2>/dev/null; then
+    kill "$FILTER_PID" 2>/dev/null || :
+  fi
+  if [ -n "$GPGV_PID" ]; then
+    wait "$GPGV_PID" 2>/dev/null || :
+    GPGV_PID=
+  fi
+  if [ -n "$FILTER_PID" ]; then
+    wait "$FILTER_PID" 2>/dev/null || :
+    FILTER_PID=
+  fi
   rm -f "$STATUS_FILE"
   rmdir "$FILTER_DIR" 2>/dev/null || :
 }
+
+signal_exit() {
+  status=$1
+  signum=$2
+  FILTER_WAS_RUNNING=no
+  trap - EXIT HUP INT TERM
+  if [ -n "$FILTER_PID" ] && kill -0 "$FILTER_PID" 2>/dev/null; then
+    FILTER_WAS_RUNNING=yes
+    kill -"$signum" "$FILTER_PID" 2>/dev/null || :
+  fi
+  if [ -n "$GPGV_PID" ] && kill -0 "$GPGV_PID" 2>/dev/null; then
+    kill -"$signum" "$GPGV_PID" 2>/dev/null || :
+  fi
+  if [ -n "$GPGV_PID" ]; then
+    wait "$GPGV_PID" 2>/dev/null || :
+    GPGV_PID=
+  fi
+  if [ "$FILTER_WAS_RUNNING" = no ] && [ -s "$STATUS_FILE" ]; then
+    start_filter
+  fi
+  if [ -n "$FILTER_PID" ]; then
+    wait "$FILTER_PID" 2>/dev/null || :
+    FILTER_PID=
+  fi
+  rm -f "$STATUS_FILE"
+  rmdir "$FILTER_DIR" 2>/dev/null || :
+  exit "$status"
+}
+
 trap cleanup EXIT
-# A signal delivered only to this shell may be deferred while the foreground
-# verifier is running. Once the verifier returns, terminate with the conventional
-# signal-derived status and let the EXIT trap remove the private status spool.
-trap 'exit 129' HUP
-trap 'exit 130' INT
-trap 'exit 143' TERM
+trap 'signal_exit 129 1' HUP
+trap 'signal_exit 130 2' INT
+trap 'signal_exit 143 15' TERM
 
-if eval 'gpgv "$@" '"$GPGSTATUSFD"'>"$STATUS_FILE"'; then
+eval 'gpgv "$@" '"$GPGSTATUSFD"'>"$STATUS_FILE"' &
+GPGV_PID=$!
+if wait "$GPGV_PID"; then
   GPGV_STATUS=0
 else
   GPGV_STATUS=$?
 fi
+GPGV_PID=
 
-if eval 'sed "s/^\[GNUPG:\] EXPKEYSIG /[GNUPG:] GOODSIG /" <"$STATUS_FILE" >&'"$GPGSTATUSFD"; then
+start_filter
+if wait "$FILTER_PID"; then
   FILTER_STATUS=0
 else
   FILTER_STATUS=$?
 fi
+FILTER_PID=
 
 if [ "$GPGV_STATUS" -ne 0 ]; then
   exit "$GPGV_STATUS"
