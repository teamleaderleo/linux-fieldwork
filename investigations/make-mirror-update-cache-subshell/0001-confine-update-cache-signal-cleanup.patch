diff --git a/upstream/mmdebstrap/make_mirror.sh b/upstream/mmdebstrap/make_mirror.sh
--- a/upstream/mmdebstrap/make_mirror.sh
+++ b/upstream/mmdebstrap/make_mirror.sh
@@ -153,10 +153,32 @@ update_cache() (
   rootdir="$newcachedir/apt"
   mkdir -p "$rootdir"
 
+  update_cache_finish() {
+    status=$1
+    trap - EXIT INT QUIT TERM
+    cleanup_status=0
+    cleanupapt || cleanup_status=$?
+    if [ "$status" -ne 0 ]; then
+      exit "$status"
+    fi
+    exit "$cleanup_status"
+  }
+
+  update_cache_exit_cleanup() {
+    update_cache_finish "$?"
+  }
+
+  update_cache_signal_exit() {
+    update_cache_finish "$1"
+  }
+
   # we only set this trap here and overwrite the previous trap, because
   # the update_cache function is run as part of a pipe and thus in its
   # own process which will EXIT after it finished
-  trap 'kill "$PROXYPID" || :;cleanupapt' EXIT INT TERM
+  trap 'update_cache_exit_cleanup' EXIT
+  trap 'update_cache_signal_exit 130' INT
+  trap 'update_cache_signal_exit 131' QUIT
+  trap 'update_cache_signal_exit 143' TERM
 
   for p in /etc/apt/apt.conf.d /etc/apt/sources.list.d /etc/apt/preferences.d /var/cache/apt/archives /var/lib/apt/lists/partial /var/lib/dpkg; do
     mkdir -p "$rootdir/$p"
@@ -254,6 +276,2 @@ update_cache() (
-  cleanupapt
-
-  # this function is run in its own process, so we unset all traps before
-  # returning
-  trap "-" EXIT INT TERM
+  update_cache_finish 0
 )
