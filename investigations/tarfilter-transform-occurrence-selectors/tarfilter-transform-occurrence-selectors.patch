     return replace
 
 
+def _sed_substitute(regex, replacement, value, occurrence, global_after):
+    selected = occurrence if occurrence > 0 else 1
+    seen = 0
+
+    def replace_selected(match):
+        nonlocal seen
+        seen += 1
+        if seen < selected:
+            return match.group(0)
+        if seen == selected or global_after:
+            return replacement(match)
+        return match.group(0)
+
+    return regex.sub(replace_selected, value)
+
