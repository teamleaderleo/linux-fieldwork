#!/bin/sh
set -eu

package=lf-script-idempotency-fixture
state_dir=/var/lib/$package
config_dir=/etc/$package
interrupt_file=/run/$package/interrupt-after

interrupt_after() {
    point=$1
    if [ -f "$interrupt_file" ] && [ "$(cat "$interrupt_file")" = "$point" ]; then
        rm -f "$interrupt_file"
        printf 'LF fixture: terminating postinst at %s\n' "$point" >&2
        kill -TERM "$$"
        exit 143
    fi
}

case "${1:-}" in
    configure)
        mkdir -p "$state_dir" "$config_dir" /usr/local/bin

        # Side effect 1: deterministic state marker.
        printf 'schema=1\n' > "$state_dir/state"
        interrupt_after after-state

        # Side effect 2: deliberately non-idempotent registry update.
        printf 'payload=/usr/share/%s/payload.txt\n' "$package" >> "$state_dir/registry"
        interrupt_after after-registry

        # Side effect 3: deterministic generated configuration.
        {
            printf 'package=%s\n' "$package"
            printf 'registry=%s/registry\n' "$state_dir"
        } > "$config_dir/generated.conf"
        interrupt_after after-config

        # Side effect 4: deterministic alternative-like link.
        ln -sfn "/usr/share/$package/payload.txt" "/usr/local/bin/$package-current"
        ;;
esac

exit 0
