#!/bin/sh
set -eu
: "${DPKG_ROOT:?DPKG_ROOT missing}"
mkdir -p "$DPKG_ROOT/var/lib/lf-fieldwork-probe"
{
  printf 'phase=preinst\n'
  printf 'arg1=%s\n' "${1-}"
  printf 'dpkg_root=%s\n' "$DPKG_ROOT"
  printf 'cwd=%s\n' "$(pwd -P)"
  printf 'uid=%s gid=%s\n' "$(id -u)" "$(id -g)"
  printf 'shell=%s\n' "$(readlink /proc/$$/exe 2>/dev/null || true)"
} >> "$DPKG_ROOT/var/lib/lf-fieldwork-probe/script.log"
